@using System.Security.Claims
@using DTOs.Forum
@inject IPostsService PostsService
@inject IForumsService ForumsService

<Modal Show="Show" Title="Create a new post" OnClose="Close">
    <form @onsubmit="HandleCreate">
        <div class="field">
            <label for="post-forum">Forum</label>
            <select id="post-forum" @bind="forumId">
                <option value="0">Choose a forum</option>
                @foreach (var f in forums)
                {
                    <option value="@f.Id">@f.Title</option>
                }
            </select>
        </div>

        <div class="field">
            <label for="post-title">Title</label>
            <input id="post-title" @bind="title" placeholder="What's on your mind?" required />
        </div>

        <div class="field">
            <label for="post-body">Body</label>
            <textarea id="post-body" @bind="body" rows="6" placeholder="Write your post..." required></textarea>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p class="error">@errorMessage</p>
        }

        <div class="modal-actions">
            <button type="button" class="btn-cancel" @onclick="Close">Cancel</button>
            <button type="submit" class="btn-primary-custom" disabled="@isSaving">
                @(isSaving ? "Posting..." : "Post")
            </button>
        </div>
    </form>
</Modal>

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<PostDto> OnCreated { get; set; }

    [CascadingParameter] public Task<AuthenticationState> State { get; set; } = null!;

    private int? userId;
    private ForumDto[] forums = [];
    private bool wasShown;
    private int forumId;
    private string title = "";
    private string body = "";
    private string? errorMessage;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        AuthenticationState authState = await State;
        ClaimsPrincipal user = authState.User;

        if (user.Identity is null || !user.Identity.IsAuthenticated)
            return;

        string idAsString = user.FindFirst(ClaimTypes.NameIdentifier)!.Value;
        userId = int.Parse(idAsString);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Show && !wasShown)
        {
            try
            {
                forums = await ForumsService.GetForumsAsync();
            }
            catch (Exception ex)
            {
                errorMessage = ex.Message;
            }
        }
        wasShown = Show;
    }

    private async Task HandleCreate()
    {
        errorMessage = null;
        if (userId == null)
        {
            errorMessage = "You must be logged in to post.";
            return;
        }
        if (forumId == 0)
        {
            errorMessage = "Please choose a forum.";
            return;
        }

        isSaving = true;
        try
        {
            var created = await PostsService.AddPostAsync(new CreatePostDto
            {
                Title = title,
                Body = body,
                UserId = userId.Value,
                ForumId = forumId
            });

            title = "";
            body = "";
            forumId = 0;
            await OnCreated.InvokeAsync(created);
            await Close();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task Close()
    {
        errorMessage = null;
        await OnClose.InvokeAsync();
    }
}