@page "/home"

@using DTOs.Forum
@inject IPostsService PostsService
@inject IForumsService ForumsService
@inject IUserService UserService
@inject UserSession Session
@implements IDisposable
@inject NavigationManager NavMgr

<PageTitle>Forum Assignment</PageTitle>

<AuthorizeView>
    <Authorizing>
        <p>
            Checking login...
        </p>
    </Authorizing>
    <Authorized>
        <div class="layout">
            <div class="feed">
                <div class="new-forum">
                    <input placeholder="New forum title" @bind="newForumTitle"/>
                    <button class="new-post-btn" @onclick="() => CreateForum(context.User.Identity?.Name)">Create forum</button>
                    @if (forumError != null)
                    {
                        <p class="feed-empty">@forumError</p>
                    }
                </div>

                <h2 class="feed-title">Latest posts</h2>

                @if (posts == null)
                {
                    <p class="feed-empty">Loading...</p>
                }
                else if (posts.Length == 0)
                {
                    <p class="feed-empty">No posts yet.</p>
                }
                else
                {
                    @foreach (var post in posts)
                    {
                        var userName = GetUserName(post.UserId);

                        <div class="post-card" @onclick="() => selectedPost = post">
                            <div class="post-avatar">@userName.Substring(0, 1).ToUpper()</div>
                            <div class="post-info">
                                <span class="post-user">@userName @(userName == context.User.Identity?.Name ? "(you)" : "")</span>
                                <h3 class="post-title">@post.Title</h3>
                            </div>
                        </div>
                    }
                }

                <CreatePostModal Show="Session.ShowNewPostModal"
                                 OnClose="Session.CloseNewPostModal"
                                 OnCreated="LoadPosts"/>

                <PostDetailModal Post="selectedPost"
                                 GetUserName="GetUserName"
                                 OnClose="() => selectedPost = null"/>
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="layout">
            <div class="feed">
                <p class="feed-empty">You are not logged in.</p>
                <button class="new-post-btn" @onclick='() => NavMgr.NavigateTo("/login")'>Go to login</button>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private PostDto[]? posts;
    private ForumDto[] forums = [];
    private Dictionary<int, string> userNames = new();
    private PostDto? selectedPost;
    private string newForumTitle = "";
    private string? forumError;

    protected override async Task OnInitializedAsync()
    {
        Session.OnChange += HandleSessionChanged;

        var users = await UserService.GetUsersAsync();
        userNames = users.ToDictionary(u => u.Id, u => u.UserName);

        await LoadPosts();
        await LoadForums();
    }

    private async Task LoadPosts()
    {
        posts = await PostsService.GetPostsAsync();
    }

    private async Task LoadForums()
    {
        forums = await ForumsService.GetForumsAsync();
    }

    private async Task CreateForum(string? currentUserName)
    {
        forumError = null;

        if (string.IsNullOrWhiteSpace(newForumTitle))
        {
            forumError = "Title is required.";
            return;
        }

        int userId = userNames.FirstOrDefault(kv => kv.Value == currentUserName).Key;
        if (userId == 0)
        {
            forumError = "Could not find the logged-in user.";
            return;
        }

        try
        {
            await ForumsService.AddForumAsync(new CreateForumDto { UserId = userId, Title = newForumTitle });
            newForumTitle = "";
            await LoadForums();
        }
        catch (Exception e)
        {
            forumError = e.Message;
        }
    }

    private void HandleSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.OnChange -= HandleSessionChanged;
    }

    private string GetUserName(int userId) =>
        userNames.TryGetValue(userId, out var name) ? name : "Unknown";
}