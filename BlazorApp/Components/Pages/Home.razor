@page "/home"
@attribute [Authorize]

@rendermode InteractiveServer
@inject IPostsService PostsService
@inject IUserService UserService
@inject UserSession Session
@implements IDisposable
@inject NavigationManager NavMgr

<PageTitle>Forum Assignment</PageTitle>

<AuthorizeView>
    <Authorized>
        <div class="layout">
            <div class="feed">
                <h2 class="feed-title">Latest posts</h2>

                @if (posts == null)
                {
                    <p class="feed-empty">Loading...</p>
                }
                else if (posts.Length == 0)
                {
                    <p class="feed-empty">No posts yet.</p>
                }
                else
                {
                    @foreach (var post in posts)
                    {
                        var userName = GetUserName(post.UserId);

                        <div class="post-card" @onclick="() => selectedPost = post">
                            <div class="post-avatar">@userName.Substring(0, 1).ToUpper()</div>
                            <div class="post-info">
                                <span class="post-user">@userName @(userName == context.User.Identity?.Name ? "(you)" : "")</span>
                                <h3 class="post-title">@post.Title</h3>
                            </div>
                        </div>
                    }
                    <CreatePostModal Show="Session.ShowNewPostModal"
                                     OnClose="Session.CloseNewPostModal"
                                     OnCreated="LoadPosts" />

                    <PostDetailModal Post="selectedPost"
                                     GetUserName="GetUserName"
                                     OnClose="() => selectedPost = null" />
                }
            </div>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="layout">
            <div class="feed">
                <p class="feed-empty">You are not logged in.</p>
                <button class="new-post-btn" @onclick='() => NavMgr.NavigateTo("/login")'>Go to login</button>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code {
    private PostDto[]? posts;
    private Dictionary<int, string> userNames = new();
    private PostDto? selectedPost;
    private bool showCreatePost;
    protected override async Task OnInitializedAsync()
    {
        Session.OnChange += HandleSessionChanged;

        var users = await UserService.GetUsersAsync();
        userNames = users.ToDictionary(u => u.Id, u => u.UserName);

        await LoadPosts();
    }

    private async Task LoadPosts()
    {
        posts = await PostsService.GetPostsAsync();
    }

    private void HandleSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Session.OnChange -= HandleSessionChanged;
    }

    private string GetUserName(int userId) =>
        userNames.TryGetValue(userId, out var name) ? name : "Unknown";
    
    
}