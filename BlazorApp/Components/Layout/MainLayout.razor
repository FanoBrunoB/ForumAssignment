@using BlazorApp.Components.Auth
@using BlazorApp.Services
@inherits LayoutComponentBase
@inject UserSession Session
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthProvider

<AuthorizeView>
    <Authorized><div class="page">
        <main>
            <div class="top-row px-4">
                <button class="new-post-btn" @onclick="Session.OpenNewPostModal" title="Create a new post">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M15.502 1.94a.5.5 0 0 1 0 .706L14.459 3.69l-2-2L13.502.646a.5.5 0 0 1 .707 0l1.293 1.293zm-1.75 2.456-2-2L4.939 9.21a.5.5 0 0 0-.121.196l-.805 2.414a.25.25 0 0 0 .316.316l2.414-.805a.5.5 0 0 0 .196-.12l6.813-6.814z"/>
                        <path fill-rule="evenodd" d="M1 13.5A1.5 1.5 0 0 0 2.5 15h11a1.5 1.5 0 0 0 1.5-1.5v-6a.5.5 0 0 0-1 0v6a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5H9a.5.5 0 0 0 0-1H2.5A1.5 1.5 0 0 0 1 2.5z"/>
                    </svg>
                    <span>New post</span>
                </button>
                <span class="welcome">Welcome @context.User.Identity?.Name!</span>
                <button class="logout-btn" @onclick="Logout">Log out</button>
            </div>

            <article class="content px-4 body">
                @Body
            </article>
        </main>
    </div>
    </Authorized>
</AuthorizeView>
<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code
{
    private void Logout()
    {
        ((SimpleAuthProvider)AuthProvider).Logout();
        Navigation.NavigateTo("/login");
    }
}
